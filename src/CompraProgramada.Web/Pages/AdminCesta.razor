@page "/admin/cesta"
@using CompraProgramada.Web.Services
@inject CompraProgradadaApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Admin - Gerenciar Cesta Top 5</PageTitle>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h1>📊 Painel Administrativo - Cesta Top 5</h1>
            <p class="text-muted">Gerencie a composição da carteira recomendada</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info" role="alert">
            <div class="spinner-border spinner-border-sm me-2" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            Carregando cesta atual...
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Erro:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    @if (cestaAtual != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Cesta Atual: @cestaAtual.Nome</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Ticker</th>
                                <th>Percentual Atual</th>
                                <th>Percentual Novo</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in novasCestaItens)
                            {
                                var itemAtual = cestaAtual.Itens.FirstOrDefault(i => i.Ticker == item.Ticker);
                                <tr>
                                    <td>
                                        <strong>@item.Ticker</strong>
                                    </td>
                                    <td>
                                        @(itemAtual?.Percentual.ToString("F2") ?? "N/A")%
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" 
                                               @bind="item.Percentual" 
                                               min="0" max="100" step="0.01" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="@(() => RemoverItem(item.Ticker))">
                                            ✕ Remover
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <td colspan="1"><strong>Total</strong></td>
                                <td><strong>@(cestaAtual.Itens.Sum(i => i.Percentual).ToString("F2"))%</strong></td>
                                <td><strong>@(somaPercentuais.ToString("F2"))%</strong></td>
                                <td>
                                    @if (somaPercentuais != 100)
                                    {
                                        <span class="badge bg-danger">Inválido</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">✓ Válido</span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-4">
                    <h6>Adicionar Novo Ativo</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <input type="text" class="form-control" 
                                   @bind="novoTicker" 
                                   placeholder="Ex: PETR4">
                        </div>
                        <div class="col-md-4 mb-2">
                            <input type="number" class="form-control" 
                                   @bind="novoPercentual" 
                                   placeholder="Percentual %" 
                                   min="0" max="100" step="0.01">
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" @onclick="AdicionarItem">
                                + Adicionar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <button class="btn btn-primary btn-lg w-100" 
                        @onclick="SalvarCesta"
                        disabled="@(somaPercentuais != 100 || isSaving)">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status">
                            <span class="visually-hidden">Salvando...</span>
                        </span>
                    }
                    💾 Salvar Cesta
                </button>
            </div>
            <div class="col-md-6">
                <button class="btn btn-secondary btn-lg w-100" @onclick="Cancelar">
                    ✕ Cancelar
                </button>
            </div>
        </div>
    }

    @if (historicoCestas?.Count > 0)
    {
        <div class="card mt-5">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Histórico de Cestas</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Nome</th>
                                <th>Data Criação</th>
                                <th>Status</th>
                                <th>Ativos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cesta in historicoCestas)
                            {
                                <tr>
                                    <td><strong>@cesta.Nome</strong></td>
                                    <td>@cesta.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (cesta.Ativa)
                                        {
                                            <span class="badge bg-success">Ativa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Desativada em @cesta.DataDesativacao?.ToString("dd/MM/yyyy")</span>
                                        }
                                    </td>
                                    <td>
                                        @string.Join(", ", cesta.Itens.Select(i => $"{i.Ticker} ({i.Percentual}%)"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private CestaResponse? cestaAtual;
    private List<CestaItemRequest> novasCestaItens = new();
    private List<CestaHistoricoResponse>? historicoCestas;
    
    private string novoTicker = "";
    private decimal novoPercentual = 0;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CarregarCestaAtual();
            await CarregarHistoricoCestas();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CarregarCestaAtual()
    {
        cestaAtual = await ApiService.GetCestaAtualAsync();
        if (cestaAtual != null)
        {
            novasCestaItens = cestaAtual.Itens
                .Select(i => new CestaItemRequest { Ticker = i.Ticker, Percentual = i.Percentual })
                .ToList();
        }
    }

    private async Task CarregarHistoricoCestas()
    {
        historicoCestas = await ApiService.GetHistoricoCestasAsync();
    }

    private void AtatualPercentual(string ticker, decimal novoPercentual)
    {
        // Automático via @bind
    }

    private void AdicionarItem()
    {
        if (string.IsNullOrWhiteSpace(novoTicker) || novoPercentual <= 0)
        {
            errorMessage = "Ticker e percentual são obrigatórios";
            return;
        }

        if (novasCestaItens.Any(i => i.Ticker.Equals(novoTicker, StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = "Este ativo já existe na cesta";
            return;
        }

        novasCestaItens.Add(new CestaItemRequest { Ticker = novoTicker.ToUpper(), Percentual = novoPercentual });
        novoTicker = "";
        novoPercentual = 0;
        errorMessage = null;
    }

    private void RemoverItem(string ticker)
    {
        novasCestaItens.RemoveAll(i => i.Ticker == ticker);
    }

    private decimal somaPercentuais => novasCestaItens.Sum(i => i.Percentual);

    private async Task SalvarCesta()
    {
        if (somaPercentuais != 100)
        {
            errorMessage = "A soma dos percentuais deve ser exatamente 100%";
            return;
        }

        if (novasCestaItens.Count != 5)
        {
            errorMessage = "A cesta deve conter exatamente 5 ativos";
            return;
        }

        isSaving = true;
        try
        {
            var sucesso = await ApiService.AtualizarCestaAsync(cestaAtual?.Nome ?? "Top Five", novasCestaItens);
            if (sucesso)
            {
                errorMessage = null;
                await CarregarCestaAtual();
                await CarregarHistoricoCestas();
            }
            else
            {
                errorMessage = "Erro ao salvar cesta";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/");
    }
}
